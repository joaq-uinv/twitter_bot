# Which account to watch. Accepts a full URL or a bare @handle.
# This is the only line you change to point the relay somewhere else.
X_PROFILE_URL=https://x.com/santtiagom_

# The bot chat (spec 003). Create the bot with @BotFather and find your chat id with
#   docker compose run --rm relay find-chat-id
# See specs/003-bot-chat-delivery/quickstart.md. Both values are secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Linked from /status. The mirror-health result /status reads is copied in by the
# workflow; locally the file is usually absent and /status says so.
STATUS_PAGE_URL=https://joaq-uinv.github.io/twitter_bot/
MIRROR_LATEST_PATH=/data/mirror-latest.json

# Which kinds of post to relay
INCLUDE_RETWEETS=true
INCLUDE_REPLIES=false
INCLUDE_QUOTES=true

POLL_INTERVAL_SECONDS=900
MAX_MESSAGES_PER_RUN=10

# Blank = the four mirrors verified working on 2026-10-21 (see config.DEFAULT_INSTANCES).
# These are volunteer-run and die regularly; see quickstart.md to refresh.
NITTER_INSTANCES=

MAX_FEED_BYTES=5242880
REQUEST_TIMEOUT_SECONDS=15.0
STATE_PATH=/data/seen.json
VERIFY_ACROSS_INSTANCES=false
LOG_LEVEL=INFO

# The container writes ./state as this uid:gid. Must match the owner of ./state,
# otherwise the relay cannot persist delivery history. Check with: id -u; id -g
HOST_UID=1000
HOST_GID=1000
